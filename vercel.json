{
  "framework": "vite",
  "installCommand": "npm --prefix frontend install",
  "buildCommand": "npm --prefix frontend run build",
  "outputDirectory": "frontend/dist",
  "rewrites": [
    {
      "source": "/api/songbase/:path*",
      "destination": "https://songbase.life/api/v2/:path*"
    },
    {
      "source": "/packet/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/p/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/((?!assets/|manifest.webmanifest|sw.js|workbox-.*).*)",
      "destination": "/index.html"
    }
  ]
}
