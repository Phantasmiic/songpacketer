{
  "rewrites": [
    {
      "source": "/packet/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/p/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/((?!assets/|manifest.webmanifest|sw.js|workbox-.*).*)",
      "destination": "/index.html"
    }
  ]
}
